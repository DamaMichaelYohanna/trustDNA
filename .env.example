# ==============================================================================
# TrustDNA Production Environment Variables (.env)
# ==============================================================================

# Application Port (Default: 80 for production or 8080)
PORT=80

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_random_password_here
POSTGRES_DB=trustdna

# Full Database Connection String (Automated in Docker Compose)
DATABASE_URL=postgresql+psycopg2://postgres:replace_with_strong_random_password_here@postgres:5432/trustdna

# Redis Cache URL (Automated in Docker Compose)
REDIS_URL=redis://redis:6379/0

# Master Cryptographic Secret for Signing Telemetry Tokens
TOKEN_SECRET=replace_with_high_entropy_hex_secret_min_32_chars

# Gunicorn Production Worker Process Count (Recommended: 2 x Num_CPUs + 1)
WORKERS=4
